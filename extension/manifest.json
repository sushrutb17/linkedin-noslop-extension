{
  "manifest_version": 3,
  "name": "LinkedIn NoSlop (dev prototype)",
  "version": "0.1.0",
  "description": "Personal prototype: blurs LinkedIn feed posts you choose to filter, with a one-click reveal. Not distributed, not on any extension store. Classifies posts with TypeSafe/Jev using your own API key.",
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "permissions": ["storage"],
  "host_permissions": ["https://www.linkedin.com/*", "https://api.typesafe.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/feed/*"],
      "js": ["src/content/content.js"],
      "css": ["src/content/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
